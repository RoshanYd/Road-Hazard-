# ─────────────────────────────────────────────────────────────
# MargRakshak Kubernetes Secret Template
# 
# Usage:
# 1. Copy this file: cp k8s/secret.yaml.example k8s/secret.yaml
# 2. Replace the placeholder values with your production credentials
# 3. Apply: kubectl apply -f k8s/secret.yaml
#
# (Note: k8s/secret.yaml is ignored by .gitignore to protect secrets)
# ─────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: margrakshak-secrets
  namespace: margrakshak
  labels:
    app.kubernetes.io/part-of: road-hazard-platform
type: Opaque
stringData:
  # Supabase or Managed PostgreSQL Connection URL
  DATABASE_URL: "postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres"

  # JWT Authentication Secrets (min 32 characters)
  JWT_SECRET_USER: "replace_with_strong_random_jwt_user_secret_min_32_chars"
  JWT_SECRET_ADMIN: "replace_with_strong_random_jwt_admin_secret_min_32_chars"

  # Vision & Conversational AI API Keys
  GEMINI_API_KEY: "your_gemini_api_key_here"
  GROQ_API_KEY: "your_groq_api_key_here"

