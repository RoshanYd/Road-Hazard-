# Backend Environment Configuration
# Copy this file to .env and configure with your actual values

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (Supabase or PostgreSQL)
# Option 1: Supabase / Direct PostgreSQL Connection URL (Recommended)
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Option 2: Local Database (used only if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=road_hazard_db
DB_USER=postgres
DB_PASSWORD=your_local_db_password

# JWT Authentication Secrets (Generate strong random strings for production, min 32 chars)
JWT_SECRET_USER=your_very_secure_random_string_for_users_min_32_chars
JWT_SECRET_ADMIN=your_very_secure_random_string_for_admins_min_32_chars

# JWT Expiration Times
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend CORS Allowed Origins
USER_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg

# AI Services
# Google Gemini API Key (Used for Vision AI road hazard classification)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Used for Saarthi conversational assistant powered by fast LLM inference)
GROQ_API_KEY=your_groq_api_key_here

# Cloud Storage (Optional - AWS S3 or Cloudinary)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=road-hazard-images
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (Optional - Nodemailer)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_gmail_app_password
# EMAIL_FROM=MargRakshak Platform <noreply@roadsafety.gov.in>

# SMS Configuration (Optional - Twilio)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_SALT_ROUNDS=12

# Logging
LOG_LEVEL=info
